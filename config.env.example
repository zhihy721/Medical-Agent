# Medical Agent local model configuration.
# You normally do not need to edit this file by hand.
# The web setup page writes the same keys into config.env.

LLM_PROVIDER=deepseek
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
# 512 在真实 provider 下可能截断最终建议（RAG 注入后回复变长，实测安全边界行被切掉），建议 1024
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_TEMPERATURE=0.2
# --- 可选：语音输入/朗读（阿里云百炼 DashScope，有免费额度）---
# 填入 key 后网页支持录音转写与助手回复朗读；音频全程内存处理不落盘。
# 也可在网页「编辑配置」面板中填写，留空则语音功能降级为提示未配置。
DASHSCOPE_API_KEY=
# 以下三键有默认值，一般无需修改：
# DASHSCOPE_VOICE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_ASR_MODEL=paraformer-v2
# DASHSCOPE_TTS_VOICE=longwan    # 朗读音色：longwan/longxiaochun/longxiaobai/longshu/longlaotie
DATA_DIR=data
LOG_DIR=logs

# --- 可选：附近医院数据源（均留空则用演示数据，功能不受影响）---
# 高德地图 Web 服务 key：高德开放平台注册后在"控制台 → 应用管理"创建（免费额度足够演示）。
# 配置后 hospital_locator 按城市检索真实 POI；拉取失败自动回退演示数据并在回复中标注。
AMAP_API_KEY=
# 或指定静态 JSON 数据源 {"hospitals": {城市: [医院条目]}}，优先级高于高德。
# 注意：这两个手填键不在 web 配置页管理范围内，经配置页保存可能被清，丢失后重新添加即可。
HOSPITAL_DATA_URL=
